# ── LINE (→ AWS SSM /recycling/line_token) ───────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# ── IOTA machine wallet (→ AWS SSM /recycling/iota_private_key_hex) ──────────
# Generated by: python cloud/scripts/setup_wallet.py
IOTA_MACHINE_PRIVATE_KEY_HEX=your_64_char_hex_private_key_here

# ── API Gateway URL (for cloud/scripts/test_endpoints.py) ────────────────────
API_BASE=https://your-api-gateway-url.execute-api.ap-northeast-1.amazonaws.com/Prod
