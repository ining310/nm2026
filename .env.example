# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=ap-northeast-1

# ── LINE (from LINE Developer Console) ───────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here
LIFF_ID=your_liff_id_here

# ── IOTA (devnet — more reliable faucet than testnet) ─────────────────────────
IOTA_NETWORK=devnet
IOTA_RPC_URL=https://indexer.devnet.iota.cafe
IOTA_FAUCET_URL=https://faucet.devnet.iota.cafe/gas
IOTA_EXPLORER_BASE=https://explorer.rebased.iota.org
IOTA_REWARD_AMOUNT_MIST=1100000000
# Generated by: python cloud/scripts/setup_wallet.py
IOTA_MACHINE_PRIVATE_KEY_HEX=your_32_byte_hex_private_key_here

# ── OpenAI (used by edge/vlm.py) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── RPi edge (edge/.env) ──────────────────────────────────────────────────────
MACHINE_ID=machine_001
API_BASE=https://your-api-gateway-url.amazonaws.com/Prod
BUTTON_PIN=17
BUTTON_DEBOUNCE_MS=300
